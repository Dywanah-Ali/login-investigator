        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1110.001: Password Guessing | T1110.001: Password Guessing &gt; Detection &gt; DET0551: Password Guessing via Multi-Source Authentication Failure Correlation &gt; AN1522: Analytic 1522&#10;Repeated failed SSH login attempts followed by a possible success from the same remote host" />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-05-12&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1110-001&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1522-analytic-1522&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.001&quot;], &quot;title&quot;: &quot;T1110.001: Password Guessing&quot;}" />
        </attvalues>
      </node>
      <node id="attack-t1110-001@20.0#t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1526-analytic-1526/1" label="attack-t1110-001@20.0#t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1526-analytic-1526/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1110.001: Password Guessing | T1110.001: Password Guessing &gt; Detection &gt; DET0551: Password Guessing via Multi-Source Authentication Failure Correlation &gt; AN1526: Analytic 1526&#10;Password guessing attempts against web-based apps (e.g., Dropbox, Google Workspace) reflected in API or sign-in logs" />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-05-12&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1110-001&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1526-analytic-1526&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.001&quot;], &quot;title&quot;: &quot;T1110.001: Password Guessing&quot;}" />
        </attvalues>
