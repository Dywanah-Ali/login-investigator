      <node id="attack-t1021@20.0#t1021-remote-services/detection/det0269-behavioral-detection-strategy-for-remote-service-logins-and-post-access-activity/an0754-analytic-0754/1" label="attack-t1021@20.0#t1021-remote-services/detection/det0269-behavioral-detection-strategy-for-remote-service-logins-and-post-access-activity/an0754-analytic-0754/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1021: Remote Services | T1021: Remote Services &gt; Detection &gt; DET0269: Behavioral Detection Strategy for Remote Service Logins and Post-Access Activity &gt; AN0754: Analytic 0754&#10;vSphere API logins (vimService) or SSH to ESXi host followed by unauthorized shell commands or lateral remote logins from the ESXi host." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2025-10-24&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1021&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1021-remote-services/detection/det0269-behavioral-detection-strategy-for-remote-service-logins-and-post-access-activity/an0754-analytic-0754&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1021&quot;], &quot;title&quot;: &quot;T1021: Remote Services&quot;}" />
        </attvalues>
      </node>
      <node id="attack-m1032@20.0#m1032-multi-factor-authentication/techniques-mitigated/t1078-valid-accounts/1" label="attack-m1032@20.0#m1032-multi-factor-authentication/techniques-mitigated/t1078-valid-accounts/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="M1032: Multi-factor Authentication | M1032: Multi-factor Authentication &gt; Techniques mitigated &gt; T1078: Valid Accounts&#10;Implement multi-factor authentication (MFA) across all account types, including default, local, domain, and cloud accounts, to prevent unauthorized access, even if credentials are compromised. MFA provides a critical layer of security by requiring multiple forms of verification beyond just a password. This measure significantly reduces the risk of adversaries abusing valid accounts to gain initial access, escalate privileges, maintain persistence, or evade defenses within your network." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2025-05-09&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-m1032&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;m1032-multi-factor-authentication/techniques-mitigated/t1078-valid-accounts&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1078&quot;], &quot;title&quot;: &quot;M1032: Multi-factor Authentication&quot;}" />
        </attvalues>
      </node>
      <node id="attack-m1032@20.0#m1032-multi-factor-authentication/techniques-mitigated/t1110-brute-force/1" label="attack-m1032@20.0#m1032-multi-factor-authentication/techniques-mitigated/t1110-brute-force/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="M1032: Multi-factor Authentication | M1032: Multi-factor Authentication &gt; Techniques mitigated &gt; T1110: Brute Force&#10;Use multi-factor authentication. Where possible, also enable multi-factor authentication on externally facing services." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2025-05-09&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-m1032&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;m1032-multi-factor-authentication/techniques-mitigated/t1110-brute-force&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110&quot;], &quot;title&quot;: &quot;M1032: Multi-factor Authentication&quot;}" />
        </attvalues>
      </node>
