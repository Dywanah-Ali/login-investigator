          <attvalue for="15" value="M1032: Multi-factor Authentication | M1032: Multi-factor Authentication &gt; Techniques mitigated &gt; T1110.002: Password Cracking&#10;Use multi-factor authentication. Where possible, also enable multi-factor authentication on externally facing services." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2025-05-09&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-m1032&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;m1032-multi-factor-authentication/techniques-mitigated/t1110-002-password-cracking&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.002&quot;], &quot;title&quot;: &quot;M1032: Multi-factor Authentication&quot;}" />
