        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="M1027: Password Policies | M1027: Password Policies &gt; Techniques mitigated &gt; T1110.001: Password Guessing&#10;Refer to NIST guidelines when creating password policies." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2024-12-18&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-m1027&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;m1027-password-policies/techniques-mitigated/t1110-001-password-guessing&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.001&quot;], &quot;title&quot;: &quot;M1027: Password Policies&quot;}" />
