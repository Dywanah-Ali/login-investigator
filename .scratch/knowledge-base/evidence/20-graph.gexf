        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="Weekly Security Meeting, 29 September 2026 | Weekly Security Meeting, 29 September 2026 &gt; Meeting details&#10;Time: 09:00 to 09:30 UTC. Chair: Thomas Price (thomas.price). Notes: Isabel Knight (isabel.knight).&#10;&#10;Also present: Freya Holland (freya.holland), Joseph Burton (joseph.burton) and Ruby Stevens (ruby.stevens). No notable security events were raised. Open actions concern routine access administration and staff guidance." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-09-29&quot;, &quot;department&quot;: &quot;IT&quot;, &quot;id&quot;: &quot;mtg-security-2026-09-29&quot;, &quot;kind&quot;: &quot;meeting&quot;, &quot;owner&quot;: &quot;Security&quot;, &quot;section_path&quot;: &quot;weekly-security-meeting-29-september-2026/meeting-details&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [], &quot;title&quot;: &quot;Weekly Security Meeting, 29 September 2026&quot;}" />
