        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1110: Brute Force | T1110: Brute Force &gt; Detection &gt; DET0463: Brute Force Authentication Failures with Multi-Platform Log Correlation &gt; AN1279: Analytic 1279&#10;Excessive login attempts followed by success from SaaS apps like O365, Dropbox, etc." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-05-12&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1110&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1110-brute-force/detection/det0463-brute-force-authentication-failures-with-multi-platform-log-correlation/an1279-analytic-1279&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110&quot;], &quot;title&quot;: &quot;T1110: Brute Force&quot;}" />
