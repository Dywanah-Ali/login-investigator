      <node id="attack-t1110-001@20.0#t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1521-analytic-1521/1" label="attack-t1110-001@20.0#t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1521-analytic-1521/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1110.001: Password Guessing | T1110.001: Password Guessing &gt; Detection &gt; DET0551: Password Guessing via Multi-Source Authentication Failure Correlation &gt; AN1521: Analytic 1521&#10;Series of authentication failures (Event ID 4625) targeting the same or similar user accounts over time from one or more remote IPs" />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-05-12&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1110-001&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1110-001-password-guessing/detection/det0551-password-guessing-via-multi-source-authentication-failure-correlation/an1521-analytic-1521&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.001&quot;], &quot;title&quot;: &quot;T1110.001: Password Guessing&quot;}" />
        </attvalues>
