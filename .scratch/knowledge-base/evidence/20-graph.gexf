          <attvalue for="16" value="{&quot;date&quot;: &quot;2025-05-09&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-m1032&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;m1032-multi-factor-authentication/techniques-mitigated/t1110-004-credential-stuffing&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.004&quot;], &quot;title&quot;: &quot;M1032: Multi-factor Authentication&quot;}" />
