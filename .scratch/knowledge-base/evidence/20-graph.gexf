        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1110.004: Credential Stuffing | T1110.004: Credential Stuffing &gt; Detection &gt; DET0460: Credential Stuffing Detection via Reused Breached Credentials Across Services &gt; AN1269: Analytic 1269&#10;Use of leaked credential pairs against Outlook Web Access (OWA), Microsoft 365, or Exchange from a single client IP with multiple failures" />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-05-12&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1110-004&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1110-004-credential-stuffing/detection/det0460-credential-stuffing-detection-via-reused-breached-credentials-across-services/an1269-analytic-1269&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110.004&quot;], &quot;title&quot;: &quot;T1110.004: Credential Stuffing&quot;}" />
