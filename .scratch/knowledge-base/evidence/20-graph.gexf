      <node id="attack-t1110@20.0#t1110-brute-force/detection/det0463-brute-force-authentication-failures-with-multi-platform-log-correlation/an1279-analytic-1279/1" label="attack-t1110@20.0#t1110-brute-force/detection/det0463-brute-force-authentication-failures-with-multi-platform-log-correlation/an1279-analytic-1279/1">
