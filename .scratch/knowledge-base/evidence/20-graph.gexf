      <node id="attack-m1027@20.0#m1027-password-policies/techniques-mitigated/t1078-002-domain-accounts/1" label="attack-m1027@20.0#m1027-password-policies/techniques-mitigated/t1078-002-domain-accounts/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="M1027: Password Policies | M1027: Password Policies &gt; Techniques mitigated &gt; T1078.002: Domain Accounts&#10;Implement and enforce strong password policies for domain accounts to ensure passwords are complex, unique, and regularly rotated. This reduces the likelihood of password guessing, credential stuffing, and other attack methods that rely on weak or static credentials." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2024-12-18&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-m1027&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;m1027-password-policies/techniques-mitigated/t1078-002-domain-accounts&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1078.002&quot;], &quot;title&quot;: &quot;M1027: Password Policies&quot;}" />
        </attvalues>
      </node>
