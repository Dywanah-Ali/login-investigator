        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="Weekly Security Meeting, 22 September 2026 | Weekly Security Meeting, 22 September 2026 &gt; Actions&#10;Joseph will bring the reset reasons to the next workload discussion. Ruby will coordinate the meeting-room check and prepare the register review. Freya will keep the travel notice reminder brief and include the company laptop name as a required detail." />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-09-22&quot;, &quot;department&quot;: &quot;IT&quot;, &quot;id&quot;: &quot;mtg-security-2026-09-22&quot;, &quot;kind&quot;: &quot;meeting&quot;, &quot;owner&quot;: &quot;Security&quot;, &quot;section_path&quot;: &quot;weekly-security-meeting-22-september-2026/actions&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [], &quot;title&quot;: &quot;Weekly Security Meeting, 22 September 2026&quot;}" />
