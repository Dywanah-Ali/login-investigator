      <node id="attack-t1110@20.0#t1110-brute-force/detection/det0463-brute-force-authentication-failures-with-multi-platform-log-correlation/an1278-analytic-1278/1" label="attack-t1110@20.0#t1110-brute-force/detection/det0463-brute-force-authentication-failures-with-multi-platform-log-correlation/an1278-analytic-1278/1">
        <viz:color r="127" g="127" b="127" />
        <attvalues>
          <attvalue for="5" value="chunk" />
          <attvalue for="15" value="T1110: Brute Force | T1110: Brute Force &gt; Detection &gt; DET0463: Brute Force Authentication Failures with Multi-Platform Log Correlation &gt; AN1278: Analytic 1278&#10;Multiple failed authentications in unified logs (e.g., loginwindow or sshd)" />
          <attvalue for="16" value="{&quot;date&quot;: &quot;2026-05-12&quot;, &quot;department&quot;: &quot;external&quot;, &quot;id&quot;: &quot;attack-t1110&quot;, &quot;kind&quot;: &quot;attack&quot;, &quot;owner&quot;: &quot;mitre&quot;, &quot;section_path&quot;: &quot;t1110-brute-force/detection/det0463-brute-force-authentication-failures-with-multi-platform-log-correlation/an1278-analytic-1278&quot;, &quot;status&quot;: &quot;current&quot;, &quot;supersedes&quot;: null, &quot;technique_ids&quot;: [&quot;T1110&quot;], &quot;title&quot;: &quot;T1110: Brute Force&quot;}" />
