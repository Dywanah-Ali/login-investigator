      <node id="attack-t1110-004@20.0#t1110-004-credential-stuffing/detection/det0460-credential-stuffing-detection-via-reused-breached-credentials-across-services/an1270-analytic-1270/1" label="attack-t1110-004@20.0#t1110-004-credential-stuffing/detection/det0460-credential-stuffing-detection-via-reused-breached-credentials-across-services/an1270-analytic-1270/1">
