# Copy this file to .env and fill in your own keys. Never commit .env.

# OpenRouter key, used to reach gpt-4o-mini. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# AbuseIPDB key, used for IP reputation lookups (free tier: 1,000 checks per day).
# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Optional dataset folder. Unset, uses backend/data/datasets/default. Must contain logins.csv.
LI_DATASET_DIR=

# Optional re-ranker switch for corpus search: on or off. Unset, it is on. On, Cohere's re-ranker
# through OpenRouter (the key above) keeps the best 5 of the 20 fused passages.
LI_RERANKER=

# PostgreSQL for the knowledge base. Run backend/setup/postgres-setup.sql once first: it makes the
# limited role and the template. The password is the limited role's, never your superuser's.
LI_PG_PASSWORD=
# Optional. Unset, they are: localhost, 5432, li_admin, li_template.
LI_PG_HOST=
LI_PG_PORT=
LI_PG_USER=
LI_PG_TEMPLATE=

# T17: run backend/setup/postgres-reader-setup.sql once as your PostgreSQL administrator.
# Separate read-only login. Never use the builder's credentials for the reader.
LI_PG_READER_PASSWORD=
# Optional; default li_reader.
LI_PG_READER_USER=
LI_GRAPH_ADMIN_PASSWORD=
LI_GRAPH_READER_PASSWORD=

# T54: optional Langfuse mirror for comparison runs. Off unless LI_LANGFUSE=on; only then are the
# keys read. Unset base URL means https://cloud.langfuse.com. The run bundle stays the original.
LI_LANGFUSE=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
