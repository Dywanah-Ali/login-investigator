# Secrets: never commit
.env
.env.*

# Agent memory: holds Investigations. The folder also holds SQLite's -wal and -shm side files.
memory/
*.sqlite
*.sqlite3
*.db

# Local pointer to the most recent successful knowledge-base build. No credentials.
.knowledge-base.json

# Python and tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Frontend dependencies and build output
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# Local editor and agent settings (machine paths)
.claude/settings.local.json

# Session handoffs: local to this machine, hold absolute paths
.scratch/handoff/

# macOS
.DS_Store

# Isolated graph versions, immutable snapshots and private serving credentials.
.graph-versions/
